<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- E5 음성 출력·인식 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- E7 차량 신호: 방향지시등(CAR_LIGHTS), 브레이크·기어(CAR_DRIVE), 충전율(CAR_ENERGY), 착좌(CAR_SEATS) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />

    <application
        android:label="들를까"
        android:allowBackup="false">

        <!-- 내비게이션 연동 확인용 화면. 판단 엔진을 붙이기 전, 에뮬레이터에서 무엇이 되는지 기록한다. -->
        <activity
            android:name=".NaviProbeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 위치 주입·근접 알림(E4)과 경유지 자리 확인용 화면. adb am start로 연다. -->
        <activity
            android:name=".LocationProbeActivity"
            android:exported="true" />

        <!-- 음성 출력·인식(E5)과 오디오 용도(E6) 확인용 화면. adb am start로 연다. -->
        <activity
            android:name=".VoiceProbeActivity"
            android:exported="true" />

        <!-- 시연 영상용 확인 화면. 칸 나누기 때 다시 만들어지지 않도록 크기·방향 변경을 직접 받는다. -->
        <activity
            android:name=".DemoProbeActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode"
            android:exported="true" />

        <!-- 차량 신호(E7) 확인용 화면. adb am start로 연다. -->
        <activity
            android:name=".VehicleProbeActivity"
            android:exported="true" />
    </application>
</manifest>
