<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- 내비게이션: 즐겨찾기·최근 목적지 읽기, 경유지 넣고 빼기, 찜까지 도로 시간(requestTrip) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- 위치(실행 중 허락을 받는 권한) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- 음성 출력·인식(Pleos 음성 서비스가 녹음하므로 앱은 RECORD_AUDIO를 쓰지 않음) -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <!-- 차량 신호: 방향지시등(CAR_LIGHTS), 브레이크·기어(CAR_DRIVE), 충전율(CAR_ENERGY), 착좌(CAR_SEATS) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <!-- 차량 속도(Android 표준 차량 속성). 읽지 못하면 잇단 위치로 어림한다 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <!--
      음성 SDK가 인터넷 권한을 합쳐 넣지만 들를까는 밖으로 아무것도 보내지 않는다. 음성·내비·위치는 기기 안 서비스에 binder로 붙으므로
      이 앱 프로세스는 인터넷이 필요 없다(2026-11-15 권한을 빼고 전 과정 확인). 빼서 "밖으로 보내지 않음"을 권한으로 지킨다
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <application
        android:label="들를까"
        android:allowBackup="false">

        <!--
          들를까의 화면은 하나다. 내비 옆 칸에 띄워 두는 앱이라 칸 크기가 바뀌어도 다시 만들어지지 않게 크기·방향 변경을 직접 받는다.
          주행 중에도 보이는 화면이라 주의 분산 최적화(DO)를 선언한다(실제 허용은 앱 마켓 심사에서 정해짐).
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <!-- 기본 테마의 제목 줄은 어두운 바탕에 어두운 글씨로 떠 읽을 수 없고 칸 높이만 차지해 뺀다(2026-11-15 에뮬레이터) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>
</manifest>
